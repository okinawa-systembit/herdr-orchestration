#!/usr/bin/env python3
"""CLI entrypoint for repo-review-helper."""

import os
import sys
from pathlib import Path

# Ensure repo root and orchestrator scripts are in sys.path
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
ORCHESTRATOR_SCRIPTS = REPO_ROOT / "skills" / "herdr-orchestrator" / "scripts"

if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))
if str(ORCHESTRATOR_SCRIPTS) not in sys.path:
    sys.path.insert(0, str(ORCHESTRATOR_SCRIPTS))

from repo_review_helper.cli import main

if __name__ == "__main__":
    sys.exit(main())
