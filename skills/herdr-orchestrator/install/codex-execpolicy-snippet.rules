# ==============================================================================
# Herdr Orchestrator: Codex execpolicy approval rules snippet
# ==============================================================================
# 本スニペットを ~/.codex/rules/default.rules に追記することで、
# Codex Agent が Herdr Orchestrator を自律実行する際の承認プロンプトを制御します。
#
# 【許可方針の分類と設計意図】
# 1. 診断・読み取り系 (doctor, task-status, task-result, task-list, identity show):
#    - 副作用のない安全な情報参照コマンドとして自動許可 (allow) します。
#    - ※ identity init は Git 設定変更を伴うため自動許可に含めません。
# 2. 自動化のための書き込み例外 (result-submit):
#    - Task Registry の更新および completion 処理を伴う書き込み操作ですが、
#      Worker Agent によるタスク完了報告の自動化を維持するため例外的に許可 (allow) します。
# 3. 意図的に自動許可しないコマンド:
#    - handoff (Worker起動・新規タスク登録)
#    - identity init (リポジトリ初期化・Git設定変更)
#    - resume-task, reset-completion, recover-completion, reconcile-dispatch (状態変更・復旧系)
#    これらは副作用が大きいため無条件許可せず、Codex 側の通常承認・サンドボックス制御に委ねます。
# 4. 開発・検証用 (npm run test:orchestrator, npm run verify:orchestrator):
#    - リポジトリ作業・検証用の任意ルールです。通常利用のみの場合は追記不要です。
# ==============================================================================

# --- 1. 診断・読み取り系 (PATH 経由: ~/.local/bin -> ~/.agents/skills/...) ---
prefix_rule(pattern=["herdr-orchestrator", ["doctor", "task-status", "task-result", "task-list"]], decision="allow", justification="Orchestrator CLI on PATH: Read-only diagnostics and status checks")
prefix_rule(pattern=["herdr-orchestrator", "identity", "show"], decision="allow", justification="Orchestrator CLI on PATH: Read-only repository identity inspection (identity init is intentionally excluded)")

# --- 2. 自動化のための書き込み例外 (PATH 経由) ---
# NOTE: result-submit は Task Registry の更新および completion 連鎖実行を伴う書き込み操作ですが、
# Worker Agent による自動結果提出を阻害しないために例外的に自動許可しています。
prefix_rule(pattern=["herdr-orchestrator", "result-submit"], decision="allow", justification="Orchestrator CLI on PATH: Automated worker result submission and completion triggering")

# --- 3. 絶対パスフォールバック (Agent が PATH ではなく絶対パスで実行する場合用) ---
# ※ GLOBAL_INSTALL_ABS を実際のインストール先ディレクトリに置換して利用してください。
#   例: /home/<user>/.agents/skills/herdr-orchestration
prefix_rule(pattern=["GLOBAL_INSTALL_ABS/scripts/herdr-orchestrator", ["doctor", "task-status", "task-result", "task-list"]], decision="allow", justification="Orchestrator CLI absolute path fallback: Read-only diagnostics and status checks")
prefix_rule(pattern=["GLOBAL_INSTALL_ABS/scripts/herdr-orchestrator", "identity", "show"], decision="allow", justification="Orchestrator CLI absolute path fallback: Read-only repository identity inspection")
prefix_rule(pattern=["GLOBAL_INSTALL_ABS/scripts/herdr-orchestrator", "result-submit"], decision="allow", justification="Orchestrator CLI absolute path fallback: Automated worker result submission and completion triggering")

# --- 4. 開発・検証用コマンド (リポジトリルートでのテスト・検証用 / 任意設定) ---
prefix_rule(pattern=["npm", "run", "test:orchestrator"], decision="allow", justification="Orchestrator unit tests (repo root)")
prefix_rule(pattern=["npm", "run", "verify:orchestrator"], decision="allow", justification="Orchestrator pre-adoption verify (repo root)")
