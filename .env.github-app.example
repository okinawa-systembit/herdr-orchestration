# GitHub App (Bot) 認証設定サンプル
# 本ファイルを .env.github-app にコピーして実際の値を設定してください。
# .env.github-app は .gitignore により Git 管理外となります。
# ※ git worktree を使用する場合も、メインリポジトリ直下の .env.github-app が自動探索されます。
#   (worktree 固有の設定が必要な場合は各 worktree 直下に配置可能)

# GitHub App ID (正の整数)
# 組織の設定画面、または GitHub App の General 画面に表示される App ID
GITHUB_BOT_APP_ID=123456

# GitHub App Installation ID (正の整数)
# リポジトリまたは組織にインストールされた GitHub App の設定画面 URL 末尾の数値
# 例: https://github.com/settings/installations/12345678 -> 12345678
GITHUB_BOT_INSTALL_ID=12345678

# GitHub App 秘密鍵 (.pem) のローカル絶対パス (または ~ から始まるパス)
GITHUB_APP_PRIVATE_KEY_PATH=/home/username/.config/github-bot/bot.pem
